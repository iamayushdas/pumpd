# App Configuration
RP_ID=localhost
ORIGIN=http://localhost:5173
WEB_PORT=5173
RP_NAME=pumpd
DATA_DIR=./data

# MongoDB Configuration (REQUIRED)
# Get your connection string from MongoDB Atlas: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=pumpd
MONGO_DB=pumpd

# Optional: Admin user IDs (comma-separated)
# Uncomment and add user IDs for admin dashboard access
# ADMIN_UIDS=user_id_1,user_id_2

# Optional: Invite-only mode
# Uncomment to require invite codes for new user registration
# INVITE_ONLY=true

# Optional: Custom ports
# PORT=3000
